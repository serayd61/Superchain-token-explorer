# ===========================================
# DATABASE (Supabase PostgreSQL)
# ===========================================
# Get from Supabase Dashboard > Settings > Database > Connection string
# Use "Transaction" mode connection string for serverless
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ===========================================
# CHAIN RPC URLs
# ===========================================
CHAIN_BASE_RPC_URL=https://mainnet.base.org
CHAIN_OPTIMISM_RPC_URL=https://mainnet.optimism.io
CHAIN_INK_RPC_URL=https://rpc-gel.inkonchain.com

# Optional chains
# CHAIN_MODE_RPC_URL=https://mainnet.mode.network
# CHAIN_ZORA_RPC_URL=https://rpc.zora.energy

# ===========================================
# EXTERNAL APIs (Optional)
# ===========================================
COINGECKO_API_KEY=
DEXSCREENER_API_KEY=

# ===========================================
# APP SETTINGS
# ===========================================
APP_NAME=Superchain Token Explorer API
APP_VERSION=1.0.0
DEBUG=false
